        <h2
            id="speakers-title"
            class="text-blue-text text-4xl font-bold text-center mb-8 mt-4 md:mt-6">
            GALERÍA
        </h2>
       <div class="mb-4"> <GalleryIsland client:load imageItems={imageItems} />
    </div>
    </div>
</section>
