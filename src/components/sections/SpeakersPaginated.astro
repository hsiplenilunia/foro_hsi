---
import { Image } from "astro:assets";

import speaker_01 from "../../assets/speakers/Alejandro_Macias.webp";
import speaker_02 from "../../assets/speakers/Antonio_Ramos_de_la_Medina.webp";
import speaker_03 from "../../assets/speakers/Celia_Mercedes_Alpuche.webp";
import speaker_04 from "../../assets/speakers/Eduardo_Gonzalez_Pier.webp";
import speaker_05 from "../../assets/speakers/Eric_Ochoa_Hein.webp";
import speaker_06 from "../../assets/speakers/Fabiana_Zepeda.webp";
import speaker_07 from "../../assets/speakers/Fabiola_Casas_Rodriguez.webp";
import speaker_08 from "../../assets/speakers/Hector_Valle.webp";
import speaker_09 from "../../assets/speakers/Isabel_Villegas.webp";
import speaker_10 from "../../assets/speakers/Jorge_Azpiri.webp";
import speaker_11 from "../../assets/speakers/Jose_Ignacio_Santos_Preciado.webp";
import speaker_12 from "../../assets/speakers/Juana_Jimenez_Sanchez.webp";
import speaker_13 from "../../assets/speakers/Liliana_Vargas_Neri.webp";
import speaker_14 from "../../assets/speakers/Luis_Fernando_Perez.webp";
import speaker_15 from "../../assets/speakers/Maria_Enriqueta_Barido_Murguia.webp";
import speaker_16 from "../../assets/speakers/Maribel_Ramirez_Coronel.webp";
import speaker_17 from "../../assets/speakers/Martha_Huertas_Jimenez.webp";
import speaker_18 from "../../assets/speakers/Mercedes_Juan_Lopez.webp";
import speaker_19 from "../../assets/speakers/Octavio_Gonzalez_Chon.webp";
import speaker_20 from "../../assets/speakers/Paulo_Castaneda.webp";
import speaker_21 from "../../assets/speakers/Rosa_Maria_Wong.webp";
import speaker_22 from "../../assets/speakers/Roxana_Trejo.webp";
import speaker_23 from "../../assets/speakers/Samuel_Ponce_de_Leon_Rosales.webp";
import speaker_24 from "../../assets/speakers/Victor_Rosenthal.webp";
import speaker_25 from "../../assets/speakers/Daniela_de_la_Rosa.webp";

const speakers = [
  { name: "Alejandro Macias", imgSrc: speaker_01 },
  { name: "Antonio Ramos de la Medina", imgSrc: speaker_02 },
  { name: "Celia Mercedes Alpuche", imgSrc: speaker_03 },
  { name: "Eduardo Gonzalez Pier", imgSrc: speaker_04 },
  { name: "Eric Ochoa Hein", imgSrc: speaker_05 },
  { name: "Fabiana Zepeda", imgSrc: speaker_06 },
  { name: "Fabiola Casas Rodriguez", imgSrc: speaker_07 },
  { name: "Hector Valle", imgSrc: speaker_08 },
  { name: "Isabel Villegas", imgSrc: speaker_09 },
  { name: "Jorge Azpiri", imgSrc: speaker_10 },
  { name: "Jose Ignacio Santos Preciado", imgSrc: speaker_11 },
  { name: "Juana Jimenez Sanchez", imgSrc: speaker_12 },
  { name: "Liliana Vargas Neri", imgSrc: speaker_13 },
  { name: "Luis Fernando Perez", imgSrc: speaker_14 },
  { name: "Maria Enriqueta Barido Murguia", imgSrc: speaker_15 },
  { name: "Maribel Ramirez Coronel", imgSrc: speaker_16 },
  { name: "Martha Huertas Jimenez", imgSrc: speaker_17 },
  { name: "Mercedes Juan Lopez", imgSrc: speaker_18 },
  { name: "Octavio Gonzalez Chon", imgSrc: speaker_19 },
  { name: "Paulo Castaneda", imgSrc: speaker_20 },
  { name: "Rosa Maria Wong", imgSrc: speaker_21 },
  { name: "Roxana Trejo", imgSrc: speaker_22 },
  { name: "Samuel Ponce de Leon Rosales", imgSrc: speaker_23 },
  { name: "Victor Rosenthal", imgSrc: speaker_24 },
  { name: "Daniela de la Rosa", imgSrc: speaker_25 },
];

const filaUno = speakers.slice(0);
---

<section class="w-full py-10 overflow-hidden bg-white" id="speakers">
  <h2 class="text-center text-3xl font-bold uppercase tracking-widest text-[#204356] mb-8">
    Speakers 
    <br>
    Anteriores
  </h2>

  <!-- Fila 1: izquierda → -->
  <div class="relative flex overflow-hidden mb-6 py-3">
    <div class="marquee-row marquee-left flex gap-12 w-max">
      {[...filaUno, ...filaUno].map((speaker) => (
        <div class="flex-shrink-0 flex items-center justify-center h-64 w-64">
          <div class="photo-container relative w-[300px] h-[300px] mb-4 flex items-end justify-center">
              <div class="photo-container__front_layer absolute inset-0 flex items-end justify-center">
                <figure class="z-10">
                  <Image
                    src={speaker.imgSrc}
                    alt={`Photo of ${speaker.name}`}
                    class="w-[300px] h-[300px] object-contain mx-auto transition-transform duration-300 hover:scale-110"
                    width={300}
                    height={300}
                    loading="lazy"
                  />
                </figure>
              </div>
            </div>
        </div>
      ))}
    </div>
  </div>

</section>

<style>
  .marquee-row {
    animation-timing-function: linear;
    animation-iteration-count: infinite;
  }

  .marquee-left {
    animation-name: scrollLeft;
    animation-duration: 50s;
  }
  
  @keyframes scrollLeft {
    0%   { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }

  @keyframes scrollRight {
    0%   { transform: translateX(-50%); }
    100% { transform: translateX(0); }
  }

  /* Pausa al hacer hover sobre toda la sección */
  .marquee-row:hover{
    animation-play-state: paused;
  }
</style>