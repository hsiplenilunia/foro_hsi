---
interface Props {
  buttonText: string;
  pdfUrl: string;
  buttonClass?: string;
}

const {
  buttonText = "Mapa del Climaterio",
  pdfUrl,
  buttonClass = "bg-purple text-white px-6 py-3 rounded-full font-semibold hover:bg-opacity-90 transition-all shadow-md focus:outline-none",
} = Astro.props;
---

<button 
  id="open-pdf-btn"
  class={buttonClass}
>
  {buttonText}
</button>

<div 
  id="pdf-modal" 
  class="fixed inset-0 z-50 hidden bg-black/60 backdrop-blur-sm items-center justify-center p-4"
>
  <div class="bg-white rounded-2xl w-full max-w-5xl h-[85vh] flex flex-col relative shadow-2xl overflow-hidden">
    
    <div class="flex justify-between items-center bg-gray-50 px-6 py-4 border-b border-gray-200">

      <h3 class="text-purple font-bold text-lg">Bases del Concurso</h3>
      <button 
        id="close-pdf-btn" 
        class="text-gray-500 hover:text-purple text-2xl font-bold p-8 focus:outline-none"
        aria-label="Cerrar modal"
      >
        &times;
      </button>
    </div>

    <div class="flex-1 w-full bg-gray-100 relative">
      <div class="hidden md:block w-full h-full">
        <embed 
          src={`${pdfUrl}#toolbar=0&navpanes=0`} 
          type="application/pdf" 
          class="w-full h-full"
        />
      </div>

      <div class="flex md:hidden flex-col items-center justify-center h-full px-6 text-center space-y-4">
        <p class="text-gray-600 text-sm">Para una mejor experiencia en dispositivos móviles, abre el documento directamente.</p>
        <a 
          href={pdfUrl} 
          target="_blank" 
          rel="noopener noreferrer" 
          class="bg-guacamole text-white px-6 py-2 rounded-xl font-medium shadow"
        >
          Abrir PDF en pantalla completa
        </a>
      </div>
    </div>
  </div>
</div>

<script>
  // Control de estados del DOM sin frameworks pesados
  const openBtn = document.getElementById('open-pdf-btn');
  const closeBtn = document.getElementById('close-pdf-btn');
  const modal = document.getElementById('pdf-modal');

  if (openBtn && closeBtn && modal) {
    openBtn.addEventListener('click', () => {
      modal.classList.remove('hidden');
      modal.classList.add('flex');
      document.body.style.overflow = 'hidden'; // Evita scroll de fondo
    });

    const closeModal = () => {
      modal.classList.remove('flex');
      modal.classList.add('hidden');
      document.body.style.overflow = ''; // Restaura scroll
    };

    closeBtn.addEventListener('click', closeModal);

    // Cerrar también si hacen clic fuera del contenedor blanco
    modal.addEventListener('click', (e) => {
      if (e.target === modal) closeModal();
    });
  }
</script>